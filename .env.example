ENV=local
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=root
DB_PASSWORD=root
DB_NAME=postgres
# capacitor://localhost and http://localhost are the WebView origins of the
# native iOS and Android apps; they are only needed for their streaming calls,
# since unary native calls bypass CORS entirely.
CORS_ALLOWED_ORIGIN=http://localhost:5173,capacitor://localhost,http://localhost
SERVER_PORT=8080
SSE_PORT=8081
COOKIE_DOMAIN=
JWT_ACCESS_TOKEN_KEY=access-key
JWT_REFRESH_TOKEN_KEY=refresh-key
EMAIL_PROVIDER=local
MAILHOG_SMTP_PORT=1025

# 'mise run pr:screenshots' publishes a pull request's screenshots to Object
# Storage. The bucket is not a secret and is the same for everyone; the keys
# are, so fill them in from the deploy API key rather than committing them.
# Without them the task refuses to upload. See the README's Scaleway section.
SCW_SCREENSHOTS_BUCKET_NAME=getstronger.screenshots
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
