<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- The app's own theme, from the moment the launch screen hands over.
         The two bars are painted because Android's defaults for them are a
         black navigation bar and a status bar in the theme's primary, and
         either reads as a band the app stops short of. This is the device's
         answer to which palette; CanvasPlugin carries the reader's. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/app_canvas</item>
        <item name="android:navigationBarColor">@color/app_canvas</item>
    </style>


    <!-- The launch screen. Android draws this one itself, from the two
         attributes below, and has ignored the android:background the Capacitor
         template points @drawable/splash at since Android 12. The canvas and
         the bar are the boot splash's own, so the splash fading in over this
         only adds the words to it — which it has to, because the system clips
         the mark to a circle no lockup fits inside. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>