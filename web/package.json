{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "lint": "eslint .",
    "preview": "vite preview",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:live": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest",
    "type-check": "tsc --build --force"
  },
  "overrides": {
    "@codecov/vite-plugin": {
      "vite": "$vite"
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/splash-screen": "8.0.2",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-web": "2.1.2",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "chart.js": "4.5.1",
    "i18next": "26.4.0",
    "immer": "11.1.18",
    "jwt-decode": "4.0.0",
    "luxon": "3.7.2",
    "posthog-js": "1.418.6",
    "react": "19.2.8",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "react-router-dom": "7.18.2",
    "sortablejs": "1.15.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@codecov/vite-plugin": "2.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/forms": "0.5.11",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@tsconfig/node20": "20.1.10",
    "@types/jsdom": "30.0.0",
    "@types/luxon": "3.7.4",
    "@types/node": "26.2.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jsdom": "30.0.1",
    "npm-run-all2": "9.0.3",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
