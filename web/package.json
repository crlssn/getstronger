{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "lint": "eslint .",
    "preview": "vite preview",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "test:e2e": "playwright test",
