{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "lint": "run-s lint:eslint lint:knip",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:knip": "knip",
    "preview": "vite preview",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:live": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest",
    "type-check": "tsc --build --force"
  },
  "overrides": {
    "@codecov/vite-plugin": {
      "vite": "$vite"
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "chart.js": "4.5.1",
    "i18next": "26.4.2",
    "immer": "11.1.18",
    "jwt-decode": "4.0.0",
    "luxon": "3.7.2",
    "maplibre-gl": "6.11.2",
    "posthog-js": "1.434.15",
    "react": "19.3.0",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-router-dom": "7.18.4",
    "sortablejs": "1.15.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@codecov/vite-plugin": "2.0.1",
    "@eslint-react/eslint-plugin": "5.20.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/forms": "0.5.11",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@tsconfig/node20": "20.1.10",
    "@types/geojson": "7946.0.16",
    "@types/jsdom": "30.0.0",
    "@types/luxon": "3.7.5",
    "@types/node": "26.6.3",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "30.1.1",
    "knip": "6.38.0",
    "npm-run-all2": "9.0.3",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
