    "@headlessui/vue": "1.7.23",
    "@heroicons/vue": "2.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@vueuse/components": "14.4.0",
    "@vueuse/core": "14.4.0",
    "@vueuse/head": "2.0.0",
    "@vueuse/integrations": "14.4.0",
